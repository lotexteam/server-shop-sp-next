# Storefront API (Laravel /api/v1) — см. server-shop/docs/STOREFRONT-API.md
# Значение видно и клиенту (вшивается в бандл на этапе build), и серверу.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8080/api/v1

# Серверная копия базы API (для generateMetadata / SSR fetch без NEXT_PUBLIC_).
# Если не задана — берётся NEXT_PUBLIC_API_BASE_URL.
API_BASE_URL=http://127.0.0.1:8080/api/v1

# Канонический origin витрины (OG-фолбэки, canonical) — только сервер.
APP_URL=http://localhost:3000

# Origin хранилища картинок (preconnect hint в <head>).
NEXT_PUBLIC_MEDIA_BASE_URL=
