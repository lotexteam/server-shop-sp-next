# Copy to .env.prod on the server. Never commit the real file.
#
# Deploy builds on the server by default (fast releases, no CI wait);
# the GHCR image is the archive/rollback source.
# Set DEPLOY_STRATEGY=pull to prefer CI-built images instead.
DEPLOY_STRATEGY=build

GH_TOKEN=
GH_USERNAME=
GH_OWNER=your-org
GH_REPO=server-shop-sp-next
GITHUB_REPOSITORY_OWNER=your-org
IMAGE_TAG=latest

# Baked into the CLIENT bundle at build time (change => rebuild image).
# In GitHub CI these come from repository Variables
# (Settings → Secrets and variables → Actions → Variables) — keep them in
# sync with the values here; update.sh smoke-checks the bundle against
# NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
NEXT_PUBLIC_MEDIA_BASE_URL=https://s3.ru1.storage.beget.cloud

# Server-only (generateMetadata/SSR fetch). Can be changed WITHOUT rebuild —
# passed as container env in docker-compose.prod.yml. Defaults to the public one.
API_BASE_URL=https://api.example.com/api/v1

# Canonical site origin (OG/canonical fallbacks).
APP_URL=https://shop.example.com

# ── Migration switch (scripts/migrate-to-next.sh управляет сам) ──────────
# Прод-алиас в сети shop, на который смотрит Caddy (у старой витрины был,
# например, shop_storefront). До переключения не занимайте прод-алиас.
STOREFRONT_ALIAS=
SHOP_NETWORK=server-shop_shop
STOREFRONT_CONTAINER_NAME=server-shop-sp-next-web
COMPOSE_PROJECT_NAME=server-shop-sp-next
CONTAINER_PORT=80
UI_PUBLISH=3100
